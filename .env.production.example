# ═══════════════════════════════════════════════════════════════════════
# MarvelSlice LMS — Production Environment (.env.production)
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production (it is gitignored).
# ═══════════════════════════════════════════════════════════════════════

# ── Postgres (used by docker-compose.prod.yml) ──
# Generate a strong password:  openssl rand -base64 24
POSTGRES_USER=lms_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=lms_prod

# ── API ──
NODE_ENV=production
DATABASE_URL=postgresql://lms_prod:CHANGE_ME_STRONG_PASSWORD@postgres:5432/lms_prod
DATABASE_CONNECTION_LIMIT=10
REDIS_URL=redis://redis:6379

# ── Auth secrets — generate with:  openssl rand -base64 48 ──
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRY=7d
CSRF_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
NEXTAUTH_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
TOKEN_ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_KEY_IN_BASE64

# ── Public URLs ──
API_URL=https://lms.marvelslice.com/api
WEB_URL=https://lms.marvelslice.com
NEXT_PUBLIC_API_URL=https://lms.marvelslice.com
NEXTAUTH_URL=https://lms.marvelslice.com

# ── Microsoft Azure AD (Teams meetings, calendar, recordings) ──
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=https://lms.marvelslice.com/api/auth/callback/azure-ad
MS_WEBHOOK_CLIENT_STATE=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# ── Rate limiting ──
RATE_LIMIT_MAX=10000

# ── Error tracking (optional) ──
SENTRY_DSN=

# ── Brevo Email (transactional email) ──
BREVO_API_KEY=CHANGE_ME_TO_YOUR_BREVO_API_KEY
EMAIL_FROM_NAME=MarvelSlice LMS
EMAIL_FROM_EMAIL=noreply@lms.marvelslice.com

# ── Landing page contact forms (Gmail SMTP) ──
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=admin@lms.marvelslice.com

# ── Razorpay Payments ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── YouTube Data API ──
YOUTUBE_API_KEY=

# ── Google Sheets (intern assignment tracker, optional) ──
GOOGLE_SHEETS_API_KEY=

# ── Landing supabase (only if the landing app uses it) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GA_MEASUREMENT_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Docker image registry (for CI/CD + docker compose build/pull) ──
# GitHub username/org + repo name, e.g. your-username/lms
REGISTRY=ghcr.io
IMAGE_NAME=your-gh-username/lms
TAG=latest
GIT_COMMIT=unknown
BUILD_TIME=unknown
NEXT_PUBLIC_APP_VERSION=1.0.1

# ── pgAdmin (management UI, reverse-proxied behind nginx basic auth) ──
PGADMIN_EMAIL=admin@marvelslice.com
PGADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Certificate system ──
# AUTO_CERTIFICATE=true