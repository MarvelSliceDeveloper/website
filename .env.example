# Database
DATABASE_URL=postgresql://lms_user:CHANGE_ME_DB_PASSWORD@localhost:5432/lms_dev
# Postgres connection pool size. Default 10. Keep below the server's max
# connections minus headroom for migrations/admin. Supabase's session-mode
# pooler caps at 15 — do NOT exceed that. Self-hosted Postgres can go higher
# (e.g. 20–50 for larger boxes). For 200 users on a 4-core box, 10 is generous.
DATABASE_CONNECTION_LIMIT=10

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRY=7d
CSRF_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
NEXTAUTH_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
NEXTAUTH_URL=http://localhost:3000

# Microsoft Azure AD (Teams meetings, calendar, recordings)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3000/api/auth/callback/azure-ad
MS_WEBHOOK_CLIENT_STATE=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# Encryption
TOKEN_ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_KEY_IN_BASE64

# Rate Limiting (global). Higher for shared IPs behind a proxy (e.g. corporate
# NAT). Per-endpoint limiters (see middleware/rate-limits.ts) provide stricter
# protection for auth routes.
RATE_LIMIT_MAX=10000

# Sentry
SENTRY_DSN=

# Brevo Email
# Get your API key from: https://app.brevo.com/ → SMTP & API → API Keys
# Free tier: 300 emails/day. For testing, use your personal email as EMAIL_FROM_EMAIL.
BREVO_API_KEY=CHANGE_ME_TO_YOUR_BREVO_API_KEY
EMAIL_FROM_NAME=LMS Portal
EMAIL_FROM_EMAIL=noreply@yourdomain.com

# Razorpay Payments
# Get keys from: https://dashboard.razorpay.com/ → Settings → API Keys
# Use test keys for development (key names end with _test)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# YouTube Data API
# Get API key: https://console.cloud.google.com/ → Enable "YouTube Data API v3"
# Free tier: 10,000 quota units/day (1 unit per video fetch)
YOUTUBE_API_KEY=

# Google Sheets — Intern Assignment Tracker
# Sheet IDs are entered in the admin UI (Admin → Interns → Assignment Tracker).
# Sheets must be publicly readable (File → Share → "Anyone with the link can view").
# Data is fetched via CSV export and tabs via the htmlview page (no credentials).
#
# Optional fallback: when the normal CSV/htmlview loading fails, the tracker
# falls back to the official Sheets API v4. Set a free read-only API key from
# Google Cloud Console (APIs & Services → Credentials), restricted to the
# Sheets API. The key only reads publicly-viewable sheets.
GOOGLE_SHEETS_API_KEY=

# App URLs
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
