# Database
DATABASE_URL=postgresql://lms_user:lms_password@localhost:5432/lms_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRY=7d
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Microsoft Azure AD (Teams meetings, calendar, recordings)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3000/api/auth/callback/azure-ad
MS_WEBHOOK_CLIENT_STATE=change-this-to-a-random-secret

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Encryption
TOKEN_ENCRYPTION_KEY=your_32_byte_encryption_key_here!

# Rate Limiting (increase for dev, decrease for production)
RATE_LIMIT_MAX=1000

# Sentry
SENTRY_DSN=

# Brevo Email
# Get your API key from: https://app.brevo.com/ → SMTP & API → API Keys
# Free tier: 300 emails/day. For testing, use your personal email as EMAIL_FROM_EMAIL.
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM_NAME=LMS Portal
EMAIL_FROM_EMAIL=noreply@yourdomain.com

# App URLs
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
