# ===========================
# LMS Portal — .gitignore
# ===========================
# Tech Stack: Next.js 14 + Express + TypeScript + Prisma + PostgreSQL + Redis
# Monorepo: Turborepo + pnpm workspaces

.omo/*

# ─────────────────────────────────
# Dependencies
# ─────────────────────────────────
.opencode/
node_modules/
.pnpm-store/

# ─────────────────────────────────
# Environment Variables
# ─────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
# Keep the template
!.env.example

# ─────────────────────────────────
# Build Output
# ─────────────────────────────────
apps/web/.next/
apps/web/out/

# Express / TypeScript
apps/api/dist/
apps/api/build/

# Shared packages
packages/*/dist/
packages/*/build/

# ─────────────────────────────────
# Turborepo
# ─────────────────────────────────
.turbo/

# ─────────────────────────────────
# Prisma
# ─────────────────────────────────
# Generated Prisma client (auto-generated, don't commit)
apps/api/node_modules/.prisma/

# SQLite dev database (if used for local testing)
# Anchored to prisma dirs only — avoids catching intentional fixture/seed .db files elsewhere
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# ─────────────────────────────────
# Testing
# ─────────────────────────────────
# Coverage reports
coverage/
apps/*/coverage/
*.lcov

# Playwright
apps/web/playwright-report/
apps/web/test-results/
tests/e2e/playwright-report/
tests/e2e/test-results/
/playwright/.cache/
blob-report/

# ─────────────────────────────────
# Docker
# ─────────────────────────────────
# Docker data volumes (local dev) — anchored to root
/docker-data/
/pgdata/
/redisdata/

# ─────────────────────────────────
# IDE / Editor
# ─────────────────────────────────
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# ─────────────────────────────────
# OS Files
# ─────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ─────────────────────────────────
# Logs
# ─────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# PM2
.pm2/

# ─────────────────────────────────
# Vercel
# ─────────────────────────────────
.vercel/

# ─────────────────────────────────
# Sentry
# ─────────────────────────────────
.sentryclirc

# ─────────────────────────────────
# Misc
# ─────────────────────────────────
# Temporary files
*.tmp
*.temp
*.bak
*.cache

# Archives
*.zip
*.tar.gz
*.rar

# Generated certificates/invoices (stored in cloud, not in repo)
# Anchored to root only — won't catch a Next.js route folder named "invoices"
/invoices/

# Uploaded files (stored in cloud, not in repo)
# Anchored to root and to the api app specifically — won't catch a Next.js
# route folder named "uploads" anywhere else in the tree
/uploads/
apps/api/uploads/

# ngrok config
ngrok.yml

# Storybook (if used)
storybook-static/

# Bundle analysis
apps/web/.next/analyze/
stats.html

# TypeScript build info
*.tsbuildinfo

# ─────────────────────────────────
# Lock files
# ─────────────────────────────────
# Keep the root pnpm-lock.yaml (not ignored).
# Ignore npm/yarn lock files anywhere (shouldn't exist in a pnpm workspace).
# Ignore any *nested* pnpm-lock.yaml (apps/*, packages/*) — only the root one is authoritative.
package-lock.json
yarn.lock
apps/*/pnpm-lock.yaml
packages/*/pnpm-lock.yaml