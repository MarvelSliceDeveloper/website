# ===========================
# LMS Portal — .gitignore
# ===========================
# Tech Stack: Next.js 14 + Express + TypeScript + Prisma + PostgreSQL + Redis
# Monorepo: Turborepo + pnpm workspaces

# ─────────────────────────────────
# Dependencies
# ─────────────────────────────────
node_modules/
.pnpm-store/
.opencode
# ─────────────────────────────────
# Environment Variables
# ─────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
# Keep the template
!.env.example

# ─────────────────────────────────
# Build Output
# ─────────────────────────────────
apps/web/.next/
apps/web/out/

# Express / TypeScript
apps/api/dist/
apps/api/build/

# Shared packages
packages/*/dist/
packages/*/build/

# ─────────────────────────────────
# Turborepo
# ─────────────────────────────────
.turbo/

# ─────────────────────────────────
# Prisma
# ─────────────────────────────────
# Generated Prisma client (auto-generated, don't commit)
apps/api/node_modules/.prisma/

# SQLite dev database (if used for local testing)
*.db
*.db-journal

# ─────────────────────────────────
# Testing
# ─────────────────────────────────
# Coverage reports
coverage/
apps/*/coverage/
*.lcov

# Playwright
apps/web/playwright-report/
apps/web/test-results/
tests/e2e/playwright-report/
tests/e2e/test-results/
/playwright/.cache/
blob-report/

# ─────────────────────────────────
# Docker
# ─────────────────────────────────
# Docker data volumes (local dev)
docker-data/
pgdata/
redisdata/

# ─────────────────────────────────
# IDE / Editor
# ─────────────────────────────────
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# ─────────────────────────────────
# OS Files
# ─────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ─────────────────────────────────
# Logs
# ─────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# PM2
.pm2/

# ─────────────────────────────────
# Vercel
# ─────────────────────────────────
.vercel/

# ─────────────────────────────────
# Sentry
# ─────────────────────────────────
.sentryclirc

# ─────────────────────────────────
# Misc
# ─────────────────────────────────
# Temporary files
*.tmp
*.temp
*.bak
*.cache

# Archives
*.zip
*.tar.gz
*.rar

# Generated certificates/invoices (stored in cloud, not in repo)
invoices/

# Uploaded files (stored in cloud, not in repo)
uploads/
apps/api/uploads/

# ngrok config
ngrok.yml

# Storybook (if used)
storybook-static/

# Bundle analysis
apps/web/.next/analyze/
stats.html

# TypeScript build info
*.tsbuildinfo

# Lock files (keep pnpm-lock.yaml, ignore others)
package-lock.json
yarn.lock
