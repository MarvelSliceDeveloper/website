# ---------------------------------------------------------
# Dockerfile.webuzo - Marvel Slice Webuzo Standalone Deployment
# ---------------------------------------------------------
# Build context = apps/landing itself (standalone).
# Use: docker compose -f apps/landing/docker-compose.yml up --build
#      OR  docker build -t marvel-slice -f Dockerfile.webuzo .
# This single-container Node image serves the built SPA (dist/)
# + handles /api/* email submissions via server.js (nodemailer).
# For monorepo production (nginx + landing-api split), see Dockerfile.
# ---------------------------------------------------------

# Stage 1: Build Frontend React App
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: Production Server Environment
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001

COPY package*.json ./
RUN npm ci --only=production

COPY --from=builder /app/dist ./dist
COPY server.js ./server.js

EXPOSE 3001

CMD ["node", "server.js"]
