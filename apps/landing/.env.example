# Marvel Slice Environment Variables Configuration
# Copy this file to .env on your hosting server (Webuzo / VPS / Vercel)

# 1. Supabase Database Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 2. Webuzo / Webizo Mail System SMTP Configuration (Type 1: Contact, Banking, Courses, Demo, Admin Reply)
SMTP_HOST=mail.marvelslice.com  # Webuzo mail host or IP (e.g., mail.yourdomain.com)
SMTP_PORT=465                    # 465 for SSL (recommended) or 587 for TLS
SMTP_SECURE=true                 # true for port 465, false for port 587
SMTP_EMAIL=info@marvelslice.com  # Your Webuzo email account
SMTP_PASSWORD=your_webuzo_email_password
ADMIN_EMAIL=admin@marvelslice.com

# 3. Webuzo Jobs & Internships SMTP Configuration (Type 2: Career Applications & Career Contact)
CAREER_SMTP_EMAIL=careers@marvelslice.com
CAREER_SMTP_PASSWORD=your_webuzo_careers_password
CAREER_ADMIN_EMAIL=hr@marvelslice.com

# (Optional: If using Gmail instead of Webuzo, set SMTP_SERVICE=gmail)
# SMTP_SERVICE=gmail

# 4. Server Port Configuration
PORT=3001
