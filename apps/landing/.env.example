# Marvel Slice Environment Variables Configuration
# Copy this file to .env on your hosting server (Webuzo / VPS / Vercel)

# 1. Supabase Database Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 2. Email SMTP Server Configuration (for form notification emails)
SMTP_EMAIL=your-company-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
ADMIN_EMAIL=admin@marvelslice.com

# 3. Server Port Configuration
PORT=3001
