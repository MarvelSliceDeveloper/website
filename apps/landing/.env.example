# Self-hosted Supabase API (same-origin on the landing domain).
# The anon key is generated by deploy/landing-supabase/setup/generate-keys.mjs
VITE_SUPABASE_URL=https://marvelslice.com
VITE_SUPABASE_ANON_KEY=replace-with-ANON_KEY-from-deploy/landing-supabase/.env

# Webuzo / Webizo Outgoing SMTP Mail Settings
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

SMTP_EMAIL=
SMTP_PASSWORD=
ADMIN_EMAIL=

CAREER_SMTP_EMAIL=
CAREER_SMTP_PASSWORD=
CAREER_ADMIN_EMAIL=

VITE_GA_MEASUREMENT_ID=
PORT=
VITE_LOOKER_STUDIO_URL=

# Public base URL used to build absolute upload URLs (/uploads/...) in emails
# and database rows. Set to https://marvelslice.com in prod, leave empty in dev.
LANDING_PUBLIC_URL=
