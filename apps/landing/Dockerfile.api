# syntax=docker/dockerfile:1
# Minimal image for the landing contact/career form email API (dev-server.js).
# Needs nodemailer + rssService + supabase client.
FROM node:22-alpine
WORKDIR /app

COPY apps/landing/dev-server.js ./dev-server.js
COPY apps/landing/src/lib ./src/lib

RUN npm install nodemailer@^6.9.16 @supabase/supabase-js@^2.111.0 --no-save --ignore-scripts

ENV NODE_ENV=production
EXPOSE 3001
CMD ["node", "dev-server.js"]